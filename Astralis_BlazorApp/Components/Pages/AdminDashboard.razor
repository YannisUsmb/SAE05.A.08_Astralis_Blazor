@page "/admin/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject AdminDashboardViewModel ViewModel
@implements IDisposable

<PageTitle>Administration – Astralis</PageTitle>

<div class="content-wrapper">
    <div class="page-header">
        <h1><i class="bi bi-shield-lock-fill me-2"></i>Centre de Modération</h1>
        <p>Gérez les publications et les demandes de la communauté.</p>
    </div>

    <div class="tabs-container animate-fade-in">
        <div class="custom-btn-group" role="group">
            <button type="button" class="tab-btn @(_showDiscoveries ? "active" : "")" @onclick="() => SwitchTab(true)">
                <i class="bi bi-telescope me-2"></i>Découvertes
                @if (ViewModel.PendingDiscoveries.Any())
                {
                    <span class="badge-custom">@ViewModel.PendingDiscoveries.Count</span>
                }
            </button>
            <button type="button" class="tab-btn @(!_showDiscoveries ? "active" : "")" @onclick="() => SwitchTab(false)">
                <i class="bi bi-tag me-2"></i>Alias
                @if (ViewModel.PendingAliases.Any())
                {
                    <span class="badge-custom warning">@ViewModel.PendingAliases.Count</span>
                }
            </button>
        </div>
    </div>

    @if (ViewModel.IsLoading)
    {
        <div class="loader-container">
            <div class="spinner-border text-accent"></div>
            <p class="mt-2 text-white-50">Chargement des données...</p>
        </div>
    }
    else
    {
        <div class="glass-panel p-4 animate-fade-in">
            
            @if (_showDiscoveries)
            {
                @if (!ViewModel.PendingDiscoveries.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-check-circle text-success-custom empty-icon"></i>
                        <h4 class="font-orbitron">Aucune découverte en attente</h4>
                        <p class="text-white-50">Les scientifiques ont bien travaillé !</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Nom Scientifique</th>
                                    <th>Type</th>
                                    <th>Auteur</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var discovery in ViewModel.PendingDiscoveries)
                            {
                                <tr>
                                    <td class="fw-bold">@discovery.CelestialBodyName</td>
                                    <td><span class="badge bg-secondary">@discovery.CelestialBodyTypeName</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-person-circle text-white-50"></i> @discovery.Username
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="action-btn-group">
                                            <a href="/corps-celestes?id=@discovery.CelestialBodyId" class="btn-icon info" title="Voir les détails" target="_blank">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <button class="btn-icon success" @onclick="() => ViewModel.ApproveDiscovery(discovery.Id)" title="Valider scientifiquement">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button class="btn-icon danger" @onclick="() => ViewModel.OpenRejectModal(discovery.Id)" title="Refuser">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                @if (!ViewModel.PendingAliases.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-emoji-smile text-warning-custom empty-icon"></i>
                        <h4 class="font-orbitron">Aucun alias en attente</h4>
                        <p class="text-white-50">La modération est à jour.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Découverte (Nom actuel)</th>
                                    <th>Alias Proposé</th>
                                    <th>Auteur</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in ViewModel.PendingAliases)
                            {
                                <tr>
                                    <td class="text-white-50">@item.CelestialBodyName</td>
                                    <td class="alias-cell">"@item.Alias"</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-person-circle text-white-50"></i> @item.Username
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="action-btn-group">
                                            <a href="/corps-celestes?id=@item.CelestialBodyId" class="btn-icon info" title="Voir le contexte" target="_blank">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <button class="btn-icon success" @onclick="() => ViewModel.OpenApproveAliasModal(item)" title="Accepter l'alias">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button class="btn-icon danger" @onclick="() => ViewModel.OpenRejectAliasModal(item)" title="Refuser (Inapproprié)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }
</div>

@if (ViewModel.IsRejectModalOpen)
{
    <div class="modal-backdrop-custom" @onclick="ViewModel.CancelModals">
        <div class="modal-glass-content animate-fade-in" @onclick:stopPropagation>
            <div class="modal-header border-0 pb-0">
                <h4 class="text-white font-orbitron text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Refuser la découverte
                </h4>
            </div>
            <div class="modal-body">
                <p class="text-white-50">Cette action est irréversible. L'auteur recevra une notification.</p>
                <div class="mb-3">
                    <label class="form-label text-white small">Motif du refus <span class="text-danger">*</span></label>
                    <textarea class="form-control-astralis" rows="4" 
                              placeholder="Ex: Données incohérentes, doublon..."
                              @bind="ViewModel.RejectionReason" 
                              @bind:event="oninput"></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 gap-2">
                <button class="btn btn-outline-light" @onclick="ViewModel.CancelModals">Annuler</button>
                <button class="btn btn-danger" 
                        @onclick="ViewModel.ConfirmRejection" 
                        disabled="@string.IsNullOrWhiteSpace(ViewModel.RejectionReason)">
                    Confirmer le refus
                </button>
            </div>
        </div>
    </div>
}

@if (ViewModel.IsConfirmAliasModalOpen && ViewModel.SelectedAliasItem != null)
{
    <div class="modal-backdrop-custom" @onclick="ViewModel.CancelModals">
        <div class="modal-glass-content animate-fade-in text-center" @onclick:stopPropagation>
            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
            </div>
            <h4 class="text-white font-orbitron mb-3">Valider l'alias ?</h4>
            <p class="text-white-50 mb-4">
                Vous êtes sur le point d'accepter le nom <strong>"@ViewModel.SelectedAliasItem.Alias"</strong> 
                pour l'objet <strong>@ViewModel.SelectedAliasItem.CelestialBodyName</strong>.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <button class="btn btn-outline-light" @onclick="ViewModel.CancelModals">Annuler</button>
                <button class="btn btn-success px-4" @onclick="ViewModel.ConfirmApproveAlias">
                    Valider
                </button>
            </div>
        </div>
    </div>
}

@if (ViewModel.IsRejectAliasModalOpen && ViewModel.SelectedAliasItem != null)
{
    <div class="modal-backdrop-custom" @onclick="ViewModel.CancelModals">
        <div class="modal-glass-content animate-fade-in text-center" @onclick:stopPropagation>
            <div class="mb-4">
                <i class="bi bi-x-circle-fill text-danger" style="font-size: 3rem;"></i>
            </div>
            <h4 class="text-white font-orbitron mb-3">Refuser l'alias ?</h4>
            <p class="text-white-50 mb-4">
                L'alias <strong>"@ViewModel.SelectedAliasItem.Alias"</strong> sera supprimé et l'utilisateur en sera notifié.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <button class="btn btn-outline-light" @onclick="ViewModel.CancelModals">Annuler</button>
                <button class="btn btn-danger px-4" @onclick="ViewModel.ConfirmRejectAlias">
                    Refuser
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showDiscoveries = true;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        await ViewModel.InitializeAsync();
    }
    
    private void SwitchTab(bool showDiscoveries)
    {
        _showDiscoveries = showDiscoveries;
    }

    private async void OnViewModelPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }
    
    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
    }
}